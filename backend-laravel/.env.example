APP_NAME="Entrega na Associação"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_LOCAL_TIMEZONE=America/Sao_Paulo

# Endereço do front (React). Vários separados por vírgula.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=encomendas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync = envia o aviso na hora, sem precisar de worker.
# Em produção, prefira "database" + `php artisan queue:work`.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ---------- Avisos por email ----------
# "log" grava os emails em storage/logs. Para enviar de verdade use smtp
# (ex.: Gmail com senha de app, Brevo, Mailtrap...).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="avisos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Avisos por WhatsApp ----------
# none (gratuito: botão "Avisar pelo meu WhatsApp") | log | zapi | ultramsg | twilio
WHATSAPP_DRIVER=none

ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
