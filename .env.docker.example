# Copie para ".env" (na mesma pasta do docker-compose.yml) para personalizar.
# Tudo aqui é opcional: sem este arquivo o sistema sobe com os valores padrão.
#
# Versão gratuita (padrão):
#   - Email automático por SMTP grátis (Gmail ou Brevo)
#   - WhatsApp pelo botão "Avisar pelo meu WhatsApp" (sem provedor pago)
#   - Internet pelo Cloudflare Tunnel (grátis)

# Porta onde o site abre: http://localhost:8080
APP_PORT=8080
APP_URL=http://localhost:8080

# Cria a associação de exemplo na primeira vez (mude para false em produção)
SEED_DEMO=true

# Senhas do banco (TROQUE em produção, antes de subir pela primeira vez)
DB_PASSWORD=encomendas_senha
DB_ROOT_PASSWORD=root_senha_troque

# ---------- Email (grátis) ----------
# "log" só grava em storage/logs. Para enviar de verdade, use smtp.
MAIL_MAILER=log

# Gmail: ative a verificação em 2 etapas e crie uma senha de app em
# https://myaccount.google.com/apppasswords (limite ~500 emails/dia)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seuemail@gmail.com
# MAIL_PASSWORD=senha-de-app-de-16-letras
# MAIL_FROM_ADDRESS=seuemail@gmail.com

# Brevo (300 emails/dia grátis): https://app.brevo.com > SMTP & API > SMTP
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=login-smtp-do-brevo
# MAIL_PASSWORD=chave-smtp-do-brevo
# MAIL_FROM_ADDRESS=remetente-verificado@seudominio.org

# ---------- WhatsApp ----------
# none = gratuito: a administração avisa pelo próprio WhatsApp com um toque.
# log  = finge que enviou e grava no log (só para desenvolvimento).
# zapi | ultramsg = envio automático (PAGO, use um chip só para isso).
WHATSAPP_DRIVER=none
# ZAPI_INSTANCE=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
# ULTRAMSG_INSTANCE=
# ULTRAMSG_TOKEN=
# twilio exige templates aprovados pela Meta (ainda não suportado aqui)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# ---------- Internet (Cloudflare Tunnel, grátis) ----------
# Só para o endereço fixo: docker compose --profile tunel up -d
# CLOUDFLARE_TUNNEL_TOKEN=
