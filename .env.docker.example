# Copie para ".env" (na mesma pasta do docker-compose.yml) para personalizar.
# Tudo aqui é opcional: sem este arquivo o sistema sobe com os valores padrão.

# Porta onde o site abre: http://localhost:8080
APP_PORT=8080
APP_URL=http://localhost:8080

# Cria a associação de exemplo na primeira vez (mude para false em produção)
SEED_DEMO=true

# Senhas do banco (TROQUE em produção, antes de subir pela primeira vez)
DB_PASSWORD=encomendas_senha
DB_ROOT_PASSWORD=root_senha_troque

# ---------- Email ----------
# "log" só grava em storage/logs. Para enviar de verdade, use smtp:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seuemail@gmail.com
# MAIL_PASSWORD=senha-de-app
# MAIL_FROM_ADDRESS=seuemail@gmail.com
MAIL_MAILER=log

# ---------- WhatsApp ----------
# none | log | zapi | ultramsg | twilio
WHATSAPP_DRIVER=log
# ZAPI_INSTANCE=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
# ULTRAMSG_INSTANCE=
# ULTRAMSG_TOKEN=
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
